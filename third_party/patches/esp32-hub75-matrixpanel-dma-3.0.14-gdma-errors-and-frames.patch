+  // LEANMESH-HUB75-PATCH-2: GDMA end-of-frame interrupt, once per frame.
+  bool IRAM_ATTR Bus_Parallel16::on_frame_end(gdma_channel_handle_t, gdma_event_data_t *, void *user)
+  {
+    Bus_Parallel16 *bus = static_cast<Bus_Parallel16 *>(user);
+    bus->_frames = bus->_frames + 1;
+    return false;
+  }
+
+  // LEANMESH-HUB75-PATCH-2: after a failed or finished bus the pins must not stay driven by the (stopped) LCD peripheral:
+  // OE (active low, d7) would hold a row lit. Every output pin becomes a plain GPIO output, low, OE high (outputs off).
+  void Bus_Parallel16::park_outputs(void)
+  {
+    for (int i = 0; i < 16; i++)
+    {
+      const int pin = _cfg.pin_data[i];
+      if (pin < 0) continue;
+      gpio_set_direction((gpio_num_t)pin, GPIO_MODE_OUTPUT);
+      gpio_set_level((gpio_num_t)pin, i == 7 ? 1 : 0);
+    }
+    if (_cfg.pin_wr >= 0)
+    {
+      gpio_set_direction((gpio_num_t)_cfg.pin_wr, GPIO_MODE_OUTPUT);
+      gpio_set_level((gpio_num_t)_cfg.pin_wr, 0);
+    }
+  }
+
   void Bus_Parallel16::release(void)
   {
+    // LEANMESH-HUB75-PATCH-2: stop the DMA before its descriptors and buffers go, free the channel and the peripheral.
+    if (dma_chan)
+    {
+      LCD_CAM.lcd_user.lcd_reset = 1;
+      LCD_CAM.lcd_user.lcd_update = 1;
+      gdma_stop(dma_chan);
+      gdma_disconnect(dma_chan);
+      gdma_del_channel(dma_chan);
+      dma_chan = nullptr;
+    }
+    if (_lcd_cam_on)
+    {
+      park_outputs();
+      periph_module_disable(PERIPH_LCD_CAM_MODULE);
+      _lcd_cam_on = false;
+    }
     if (_i80_bus)
     {
       esp_lcd_del_i80_bus(_i80_bus);
@@ -319,6 +379,11 @@
