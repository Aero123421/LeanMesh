diff --git a/library/core/classic/edhoc_classic_message_2.c b/library/core/classic/edhoc_classic_message_2.c
index 736ac4a..b1ba890 100644
--- a/library/core/classic/edhoc_classic_message_2.c
+++ b/library/core/classic/edhoc_classic_message_2.c
@@ -138,7 +138,8 @@ STATIC int parse_g_y_ciphertext_2(struct edhoc_context *ctx,
 	const int ret = cbor_decode_message_2_G_Y_CIPHERTEXT_2(msg_2, msg_2_len,
 							       &output, &len);
 
-	if (ZCBOR_SUCCESS != ret) {
+	if (ZCBOR_SUCCESS != ret || len != msg_2_len) {
+		/* A message is exactly one CBOR item, without trailing data. */
 		return EDHOC_ERROR_CBOR_FAILURE;
 	}
 
